# === Confluence ===
CONFLUENCE_BASE_URL=http://localhost:8090
CONFLUENCE_USERNAME=your-username
CONFLUENCE_API_TOKEN=your-password
# CONFLUENCE_TIMEOUT=30

# === MCP Server ===
MCP_PORT=8003

# === Score-based merge (search_content: score_merge=true) ===
# SCORE_MERGE_MAX_VARIANTS=12

# === LLM Rewrite (search_content: llm_rewrite=true) ===
# Fill endpoint to enable; leave empty to disable.
# LLM_REWRITE_PROVIDER=openai          # openai | anthropic
# LLM_REWRITE_ENDPOINT=http://localhost:11434/v1/chat/completions
# LLM_REWRITE_MODEL=qwen2.5
# LLM_REWRITE_API_KEY=
# LLM_REWRITE_TIMEOUT=5
